{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/karanjasani/agentkit/schemas/repomap.v1/envelope.schema.json",
  "title": "repomap.v1 envelope",
  "description": "The outer wrapper for every repomap response. Exactly one of result or error is present.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "tool_version", "ok"],
  "properties": {
    "schema": { "const": "repomap.v1" },
    "tool_version": { "type": "string" },
    "ok": { "type": "boolean" },
    "result": {},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "recoverable"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "recoverable": { "type": "boolean" }
      }
    }
  },
  "oneOf": [
    {
      "properties": { "ok": { "const": true } },
      "required": ["result"]
    },
    {
      "properties": { "ok": { "const": false } },
      "required": ["error"]
    }
  ]
}
